<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Desde Android 17 (API 37) hace falta para hablar con el backend propio en la red local (10.0.2.2 / 192.168.x) -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <!-- Desde Android 13 (API 33) las notificaciones no se muestran si el usuario no da este permiso -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Para guardar dónde se publicó una reseña y poder pintarla en el mapa.
         Es opcional: si el usuario lo niega, la reseña se publica sin ubicación
         y simplemente no aparece en el mapa.
         Solo COARSE: al mapa le basta el barrio, y así alcanza con un
         RequestPermission sencillo (declarar también FINE obligaría a pedir los
         dos juntos desde API 31). -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- La app funciona sin GPS: sin él las reseñas se publican sin ubicación -->
    <uses-feature
        android:name="android.hardware.location"
        android:required="false" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name=".MotorMatesApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.MotorMates">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.MotorMates"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Recibe los mensajes que manda la Cloud Function por FCM -->
        <service
            android:name=".notifications.MotorMatesMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Canal con el que Android agrupa las notificaciones que llegan sin
             canal propio (las que el sistema pinta solo, con la app cerrada).
             El servicio crea este mismo canal al arrancar. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="@string/notification_channel_id" />

        <!-- La llave sale de local.properties vía manifestPlaceholders (ver
             build.gradle.kts). La de google-services.json no sirve: no está
             habilitada para el Maps SDK. -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
